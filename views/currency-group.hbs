<!DOCTYPE html>
<html>

<head>
  <meta charset="utf-8">
  <title>Currency Group Selection</title>
  <link rel="stylesheet" href="mini.css/mini-default.min.css?v=1a4c94f2400d4a4aa2be758f7c55fec9" />
</head>

<body>
  <fieldset>
    <legend>Currency Group Selection</legend>   

    <form id="currency" action="CurrencyGroup/group" method="get">  
      <div style="margin-bottom: 15px;">
        <label for="group">Currency Group</label>            
      </div>  

      {{#if isONEworksVGCash}}        
        <div class="input-group vertical">
            <div style="height: 40px;">
              <input type="radio" id="groupTypeVN" name="groupType" checked="checked" value="VN" style="vertical-align: middle;" onclick="enableDisableCurrencyGroupSelect()"/>
              <label for="groupTypeVN">VN</label>            
            </div>
            <div>
              <input type="radio" id="groupTypeOthers" name="groupType" value="Others" style="vertical-align: middle;" onclick="enableDisableCurrencyGroupSelect()"/>
              <label for="groupTypeOthers">Others</label>            
            </div>
            <div>
              <input type="radio" name="groupType" id="groupTypeSpecific" value="Specific" style="vertical-align: middle;" onclick="enableDisableCurrencyGroupSelect()"/>
              <label for="groupTypeSpecific">Specific</label>            
              <select name="group" type="string" id="currencyGroupSelect" form="currency" disabled>
                {{#each groups}}
                <option value={{this._id}}>{{this.name}}</option>
                {{/each}}
              </select>
            </div> 
        </div>
      {{else}}
        <div class="input-group vertical">
            <div>
              <input type="radio" id="groupTypeOthers" name="groupType" checked="checked" value="Default" style="vertical-align: middle;" onclick="enableDisableCurrencyGroupSelect()"/>
              <label for="groupTypeOthers">Default</label>            
            </div>
            <div>
              <input type="radio" id="groupTypeSpecific" name="groupType" value="Specific" style="vertical-align: middle;" onclick="enableDisableCurrencyGroupSelect()"/>
              <label for="groupTypeSpecific">Specific</label>            
              <select name="group" type="string" id="currencyGroupSelect" form="currency" disabled>
                {{#each groups}}
                <option value={{this._id}}>{{this.name}}</option>
                {{/each}}
              </select>
            </div> 
        </div>
      {{/if}}      

      <input name="token" type="text" value="{{token}}" hidden="true" />
      <input name="language" type="text" value="{{language}}" hidden="true" />
      <input name="gameId" type="number" value="{{gameId}}" hidden="true" />
      <input name="ref" type="text" value="{{ref}}" hidden="true" />
      <input name="rurl" type="text" value="{{returnUrl}}" hidden="true" />
      <input name="partnerId" type="string" value="{{partnerId}}" hidden="true" />
      <input type="submit" value="Submit" class="primary" />
    </form>
  </fieldset>

  <script type="application/javascript">
    function enableDisableCurrencyGroupSelect(){
      if(document.getElementById('groupTypeSpecific').checked){
        document.getElementById('currencyGroupSelect').disabled = false;
      }
      else{
        document.getElementById('currencyGroupSelect').disabled = true;
      }
    }   
  </script>
</body>

</html>