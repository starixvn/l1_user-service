<!DOCTYPE html>
<html>

<head>
  <meta charset="utf-8">
  <title>Currency</title>
  <link rel="stylesheet" href="/mini.css/mini-default.min.css" />
</head>

<body>

  <fieldset>
    <legend>Currency Group Selection</legend>
    <form id="currency" action="currency-group/group" method="get">
      <input name="token" type="text" value="{{token}}" hidden="true" />
      <div class="input-group vertical">
        <label for="group">Currency Group</label>
        <select name="group" type="string" id="group" form="currency">
          {{#each groups}}
          <option value={{this._id}}>{{this.name}}</option>
          {{/each}}
        </select>
      </div>

      <input type="submit" value="Submit" class="primary" />
    </form>
  </fieldset>

</body>

</html>