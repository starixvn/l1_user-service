{
    "name": "sc-user-service",
    "private": true,
    "version": "1.0.0",
    "description": "Nest TypeScript starter repository",
    "license": "MIT",
    "scripts": {
        "prebuild": "rimraf dist",
        "build": "nest build",
        "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
        "start": "nest start",
        "start:dev": "nest start --watch",
        "start:debug": "nest start --debug --watch",
        "start:prod": "node dist/main.js",
        "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
        "test": "jest --runInBand",
        "test:watch": "jest --watch",
        "test-coverage": "jest --coverage --runInBand",
        "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
        "test:e2e": "jest --config ./__tests__/jest-e2e.json",
        "reg": "npm set registry http://npm.lumigame.com"
    },
    "dependencies": {
        "@nestjs/axios": "^0.0.7",
        "@nestjs/common": "7.6.5",
        "@nestjs/config": "^0.6.2",
        "@nestjs/core": "7.6.5",
        "@nestjs/jwt": "^8.0.0",
        "@nestjs/mongoose": "7.2.2",
        "@nestjs/platform-fastify": "7.6.7",
        "@nestjs/schedule": "^2.2.0",
        "@nestjs/swagger": "^4.7.12",
        "@nestjs/terminus": "^7.1.0",
        "@sentry/node": "^6.0.2",
        "@types/randomstring": "^1.1.6",
        "@types/validator": "^13.1.3",
        "axios": "^0.21.1",
        "cache-manager": "^3.4.4",
        "chance": "^1.1.7",
        "class-transformer": "^0.5.1",
        "class-validator": "0.14.0",
        "compression": "^1.7.4",
        "dotenv": "^8.2.0",
        "fastify-helmet": "^5.1.0",
        "fastify-static": "^4.4.2",
        "fastify-swagger": "^4.1.1",
        "handlebars": "^4.7.7",
        "jsonwebtoken": "^8.5.1",
        "jwks-rsa": "^1.7.0",
        "mongoose": "5.11.13",
        "openid-client": "^4.3.0",
        "point-of-view": "^4.15.2",
        "randomstring": "^1.1.5",
        "reflect-metadata": "0.1.13",
        "rimraf": "3.0.2",
        "rxjs": "6.6.3",
        "sc-instrument": "1.1.0",
        "simpl-schema": "^1.7.3",
        "validator": "^13.5.2"
    },
    "devDependencies": {
        "@commitlint/cli": "^13.1.0",
        "@commitlint/config-conventional": "^13.1.0",
        "@nestjs/cli": "7.5.4",
        "@nestjs/schematics": "7.2.7",
        "@nestjs/testing": "7.6.5",
        "@types/cache-manager": "^3.4.2",
        "@types/cron": "^2.0.0",
        "@types/express": "4.17.11",
        "@types/jest": "^29.5.5",
        "@types/node": "14.14.22",
        "@types/supertest": "2.0.10",
        "@types/ws": "7.4.0",
        "@typescript-eslint/eslint-plugin": "4.14.0",
        "@typescript-eslint/parser": "4.14.0",
        "eslint": "7.18.0",
        "eslint-config-prettier": "7.2.0",
        "eslint-plugin-import": "2.22.1",
        "express": "4.17.3",
        "husky": "^7.0.1",
        "jest": "29.7.0",
        "jest-date-mock": "^1.0.8",
        "jest-extended": "^0.11.5",
        "jest-micro-auto-stub": "^1.0.6",
        "jest-sonar-reporter": "^2.0.0",
        "jest-when": "^3.5.1",
        "mongodb-memory-server": "^8.11.5",
        "prettier": "2.2.1",
        "supertest": "6.1.1",
        "ts-jest": "29.1.1",
        "ts-loader": "8.0.14",
        "ts-node": "9.1.1",
        "tsconfig-paths": "3.9.0",
        "typescript": "5.1.6"
    },
    "jest": {
        "moduleFileExtensions": [
            "js",
            "json",
            "ts"
        ],
        "rootDir": "src",
        "testRegex": ".*\\.spec\\.ts$",
        "transform": {
            "^.+\\.(t|j)s$": "ts-jest"
        },
        "collectCoverageFrom": [
            "**/*.(t|j)s"
        ],
        "coverageDirectory": "../coverage",
        "testEnvironment": "node",
        "testResultsProcessor": "jest-sonar-reporter",
        "setupFilesAfterEnv": [
            "jest-extended"
        ]
    },
    "jestSonar": {
        "reportPath": "reports",
        "reportFile": "test-reporter.xml",
        "indent": 4
    }
}
